# Server
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
WEB_DIST_DIR=web/dist

# PostgreSQL (optional for local dev — omits to zero-config seeded MemoryRepo)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/toc_open

# Arweave / ArDrive Turbo Open Data Archiving (optional — defaults to deterministic LocalMockAdapter)
# ARWEAVE_UPLOAD_ENDPOINT=https://upload.ardrive.io/v1/tx
# ARWEAVE_GRAPHQL_ENDPOINT=https://arweave.net/graphql
# ARWEAVE_API_TOKEN=

# Optional OAuth Providers (X OAuth 2.0 PKCE & GitHub OAuth)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3001/auth/x/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# Optional LLM Key for "Create from Documents" (Quote-Locked Multi-Doc Extraction)
# Pick ONE provider — OpenRouter recommended (1 key gives Gemini 2.5 Flash, Claude Sonnet, GPT-4.1):
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model override (defaults: google/gemini-2.5-flash on OpenRouter, claude-sonnet-4-5-20250929 on Anthropic, gpt-4.1-mini on OpenAI)
# LLM_MODEL=
