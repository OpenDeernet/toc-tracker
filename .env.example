# Server
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
WEB_DIST_DIR=web/dist

# PostgreSQL (optional for local dev — omits to zero-config seeded MemoryRepo)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/toc_open

# Arweave / ArDrive Turbo Open Data Archiving (optional — defaults to deterministic LocalMockAdapter)
# ARWEAVE_UPLOAD_ENDPOINT=https://upload.ardrive.io/v1/tx
# ARWEAVE_GRAPHQL_ENDPOINT=https://arweave.net/graphql
# ARWEAVE_API_TOKEN=

# Optional OAuth Providers (X & GitHub)
# X_CLIENT_ID=
# X_REDIRECT_URI=http://localhost:3001/auth/x/callback
# GITHUB_CLIENT_ID=
# GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# Optional LLM Key for AI-Assisted Paste-Link / Draft Extraction
# OPENAI_API_KEY=
