# Server
PORT=3001
PUBLIC_BASE_URL=https://toctracker.com
WEB_DIST_DIR=web/dist

# PostgreSQL (required in prod; omit locally to use zero-config seeded MemoryRepo)
# DATABASE_URL=postgres://user:pass@host:5432/toctracker
# Set RESEED=1 once to wipe & reload the 26-profile seed bundle (leave unset in prod!)
# RESEED=0

# Auth — Production defaults to ALLOW_DEV_LOGIN=false whenever PUBLIC_BASE_URL is https://
# ALLOW_DEV_LOGIN=false
# Comma-separated X handles granted curator/admin privileges over seeded drafts (e.g. @yourhandle)
# ADMIN_X_HANDLES=
# X (Twitter) OAuth 2.0 PKCE — callback: https://toctracker.com/auth/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://toctracker.com/auth/x/callback
# GitHub OAuth — callback: https://toctracker.com/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://toctracker.com/auth/github/callback
# Verified Email Magic Links via Resend (recommended alongside X/GitHub)
# RESEND_API_KEY=
# EMAIL_FROM=ToC Tracker <login@toctracker.com>

# Optional LLM Key for "Create from Documents" & "Deep Stress-Test (AI)"
# Pick ONE provider — OpenRouter recommended (1 key gives Gemini 2.5 Flash, Claude Sonnet, GPT-4.1):
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model override (defaults: google/gemini-2.5-flash on OpenRouter, claude-sonnet-4-5-20250929 on Anthropic, gpt-4.1-mini on OpenAI)
# LLM_MODEL=

# Arweave / ArDrive Turbo Open Data Archiving (FREE for <100 KiB snapshots — no wallet balance needed!)
# ARWEAVE_UPLOAD_ENDPOINT=https://upload.ardrive.io/v1/tx
# ARWEAVE_GRAPHQL_ENDPOINT=https://arweave.net/graphql
# Optional persistent 32-byte Ed25519 publisher key (base64url-nopad); generates ephemeral if unset:
# ARWEAVE_SIGNER_SECRET_B64=
# Optional API token if using a custom bundler:
# ARWEAVE_API_TOKEN=
